#!/usr/bin/env bash
set -euo pipefail

# Capture exported values before launcher globals or Bash locals can shadow them.
# Reserve _AGENTS_* for this snapshot and its restoration machinery.
mapfile -d '' -t _AGENTS_ORIGINAL_ENV < <(env -0)
RUN_ENV_EXPORTS=()

IMAGE="${CLAUDE_ISOLATED_IMAGE:-localhost/claude-one-folder}"
STATE_VOLUME="${CLAUDE_ISOLATED_STATE_VOLUME:-claude-state}"
RUN_CONTAINER_NAME="${CLAUDE_ISOLATED_CONTAINER_NAME:-claude-isolated}"
LOGIN_CONTAINER_NAME="${CLAUDE_ISOLATED_LOGIN_CONTAINER_NAME:-claude-isolated-login}"
RUN_ENV_ARGS=()
ENV_NAMES=()
SECRET_NAMES=()

usage() {
  cat <<'USAGE'
Usage:
  claude-isolated [--env NAME] [--secret-env VARIABLE=SECRET_NAME] [run] [CLAUDE_ARGS...]
  claude-isolated login
  claude-isolated auth-status
  claude-isolated logout
  claude-isolated verify
  claude-isolated version
  claude-isolated help

Run mode mounts the current Git repository at /workspaces/<name>-<id> and
the persistent Claude state volume at /state/claude.

Environment options are repeatable and must precede run/Claude arguments.
--env forwards an exported host variable by name; --secret-env supplies a
Podman secret as a container environment variable. Neither accepts token values.
Use run or -- to end launcher option parsing. Helpers receive no selected variables.
USAGE
}

fail() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command '$1' is not installed"
}

register_env_name() {
  local name="$1" existing
  [[ "$name" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || fail "invalid environment variable name"
  case "$name" in
    HOME|CLAUDE_CONFIG_DIR|DISABLE_AUTOUPDATER|DISABLE_UPDATES)
      fail "'$name' is reserved for the Claude container configuration" ;;
  esac
  [[ "$name" != _AGENTS_* ]] || fail "environment names beginning _AGENTS_ are reserved"
  for existing in "${ENV_NAMES[@]}"; do
    [[ "$existing" != "$name" ]] || fail "environment variable '$name' was selected more than once"
  done
  ENV_NAMES+=("$name")
}

select_host_env() {
  for _AGENTS_ENTRY in "${_AGENTS_ORIGINAL_ENV[@]}"; do
    if [[ "${_AGENTS_ENTRY%%=*}" == "$1" ]]; then
      RUN_ENV_EXPORTS+=("$_AGENTS_ENTRY")
      return
    fi
  done
  fail "environment variable '$1' is not exported"
}

run_selected_podman() (
  # Shell builtins restore values without putting secrets in a process argv.
  # Arguments have already been expanded before any selected name is restored.
  for _AGENTS_ENTRY in "${RUN_ENV_EXPORTS[@]}"; do
    _AGENTS_KEY="${_AGENTS_ENTRY%%=*}"
    if [[ "$(declare -p "$_AGENTS_KEY" 2>/dev/null || :)" =~ ^declare\ -[^[:space:]]*r ]]; then
      [[ "${!_AGENTS_KEY}" == "${_AGENTS_ENTRY#*=}" ]] \
        || fail "cannot restore changed readonly Bash variable '$_AGENTS_KEY'"
      export "${_AGENTS_KEY?}"
    else
      # Globals may be arrays now; reset their type before restoring a scalar.
      unset "$_AGENTS_KEY"
      export "${_AGENTS_ENTRY?}"
    fi
  done
  exec podman "$@"
)

lock_workspace() {
  local lock_dir lock_id active
  require_command flock
  require_command sha256sum
  lock_dir="${XDG_RUNTIME_DIR:-/tmp}/agents-podman-${UID}"
  (umask 077; mkdir -p -- "$lock_dir")
  [[ -d "$lock_dir" && ! -L "$lock_dir" && -O "$lock_dir" ]] \
    || fail "unsafe workspace lock directory '$lock_dir'"
  lock_id="$(printf '%s' "$1" | sha256sum)"
  # fd 9 is deliberately inherited by Podman so the lock lasts for the session.
  exec 9>"$lock_dir/${lock_id%% *}.lock"
  flock -n 9 || fail "this repository is already in use by an isolated agent; stop that session before launching another"
  _AGENTS_WORKSPACE_ID="${lock_id%% *}"
  # Detached containers can outlive their launcher and its lock.
  active="$(podman ps --filter "label=io.agents-podman.workspace=$_AGENTS_WORKSPACE_ID" \
    --filter status=running --format '{{.Names}}')"
  [[ -z "$active" ]] || fail "this repository is mounted by running container(s): $active; stop them before launching another agent"
  # The launcher holds fd 9 while waiting for Podman. Never delete lock files:
  # unlinking a lock file could allow two processes to lock different inodes.
}

git_metadata_digest() {
  # Hooks and Git config run on the host during later Git commands. Hash file
  # contents, and record types/modes/link targets without following links.
  { find "$1/.git/config" "$1/.git/config.worktree" "$1/.git/hooks" \
      -printf '%y %m %p %l\n' -type f -exec sha256sum -- {} + 2>/dev/null || :; } \
    | LC_ALL=C sort | sha256sum
}

warn_if_git_metadata_changed() {
  [[ "$(git_metadata_digest "$1")" == "$2" ]] && return
  printf 'Warning: the session changed .git/config or .git/hooks in %s.\n' "$1" >&2
  printf 'Review them before running Git on the host; they can execute host commands.\n' >&2
}

parse_env_options() {
  local name secret
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --env)
        [[ $# -ge 2 ]] || fail "--env requires NAME"
        name="$2"
        register_env_name "$name"
        select_host_env "$name"
        RUN_ENV_ARGS+=(--env "$name")
        shift 2
        ;;
      --secret-env)
        [[ $# -ge 2 && "$2" == *=* ]] || fail "--secret-env requires VARIABLE=SECRET_NAME"
        name="${2%%=*}"
        secret="${2#*=}"
        register_env_name "$name"
        [[ "$secret" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || fail "invalid Podman secret name"
        RUN_ENV_ARGS+=(--secret "${secret},type=env,target=${name}")
        SECRET_NAMES+=("$secret")
        shift 2
        ;;
      *) break ;;
    esac
  done
  main_command "$@"
}

check_rootless() {
  local rootless
  rootless="$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null || true)"
  [[ "$rootless" == "true" ]] || fail "Podman must be run rootless as your normal user"
}

check_image_and_state() {
  podman image exists "$IMAGE" || fail "image '$IMAGE' does not exist; run install.sh first"
  podman volume exists "$STATE_VOLUME" || fail "state volume '$STATE_VOLUME' does not exist; run install.sh first"
}

cleanup_stale_container() {
  local name="$1"
  if podman container exists "$name"; then
    if [[ "$(podman inspect --format '{{.State.Running}}' "$name" 2>/dev/null || true)" == "true" ]]; then
      fail "container '$name' is already running; attach with: podman attach $name; stop with: podman stop $name; remove after stopping with: podman rm $name"
    fi
    podman rm "$name" >/dev/null
  fi
}

workspace_root() {
  local root home_real

  git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || fail "current directory is not inside a Git working tree"

  root="$(git rev-parse --show-toplevel)"
  root="$(realpath -e -- "$root")"
  home_real="$(realpath -e -- "$HOME")"

  [[ "$root" != "/" ]] || fail "refusing to mount the filesystem root"
  [[ "$home_real/" != "$root/"* ]] || fail "refusing to mount your home directory or one of its parents"
  [[ "$root" != *$'\n'* && "$root" != *$'\r'* ]] \
    || fail "workspace paths containing line breaks are not supported"
  [[ "$root" != *","* ]] || fail "workspace paths containing commas are not supported"

  printf '%s\n' "$root"
}

run_claude() {
  local workspace secret workspace_id workspace_name container_workspace git_before status=0
  workspace="$(workspace_root)"
  # Linked worktrees and external Git dirs cannot work with a root-only mount.
  [[ -d "$workspace/.git" && ! -L "$workspace/.git" ]] \
    || fail "linked worktrees, submodule roots, and external Git directories are not supported; use a standalone clone"
  workspace_id="$(printf '%s' "$workspace" | sha256sum)"
  workspace_id="${workspace_id:0:16}"
  workspace_name="$(printf '%s' "${workspace##*/}" | LC_ALL=C tr -c 'a-zA-Z0-9_.-' '-')"
  workspace_name="${workspace_name:0:48}"
  container_workspace="/workspaces/${workspace_name}-${workspace_id}"

  for secret in "${SECRET_NAMES[@]}"; do
    podman secret exists "$secret" || fail "Podman secret '$secret' is unavailable; create it on the host first"
  done

  cleanup_stale_container "$RUN_CONTAINER_NAME"
  lock_workspace "$workspace"

  printf 'Workspace: %s\n' "$workspace" >&2
  git_before="$(git_metadata_digest "$workspace")"

  run_selected_podman run --rm -it \
    --name "$RUN_CONTAINER_NAME" \
    --label "io.agents-podman.workspace=$_AGENTS_WORKSPACE_ID" \
    --label io.agents-podman.agent=claude \
    --http-proxy=false \
    --cap-drop=all \
    --security-opt=no-new-privileges \
    --mount "type=bind,src=${workspace},dst=${container_workspace},relabel=private,bind-nonrecursive" \
    --mount "type=volume,src=${STATE_VOLUME},dst=/state/claude" \
    --workdir "$container_workspace" \
    "${RUN_ENV_ARGS[@]}" \
    "$IMAGE" \
    "$@" || status=$?
  warn_if_git_metadata_changed "$workspace" "$git_before"
  return "$status"
}

login_claude() {
  cleanup_stale_container "$LOGIN_CONTAINER_NAME"

  exec podman run --rm -it \
    --name "$LOGIN_CONTAINER_NAME" \
    --label io.agents-podman.agent=claude \
    --http-proxy=false \
    --cap-drop=all \
    --security-opt=no-new-privileges \
    --mount "type=volume,src=${STATE_VOLUME},dst=/state/claude" \
    "$IMAGE" auth login
}

auth_status() {
  podman run --rm \
    --http-proxy=false \
    --cap-drop=all \
    --security-opt=no-new-privileges \
    --mount "type=volume,src=${STATE_VOLUME},dst=/state/claude" \
    "$IMAGE" auth status
}

logout_claude() {
  podman run --rm -it \
    --http-proxy=false \
    --cap-drop=all \
    --security-opt=no-new-privileges \
    --mount "type=volume,src=${STATE_VOLUME},dst=/state/claude" \
    "$IMAGE" auth logout
}

show_version() {
  podman run --rm \
    --http-proxy=false \
    --cap-drop=all \
    --security-opt=no-new-privileges \
    "$IMAGE" --version
}

verify_setup() {
  local rootless enforcing privileged caps security_opts

  printf 'Checking Podman...\n'
  rootless="$(podman info --format '{{.Host.Security.Rootless}}')"
  [[ "$rootless" == "true" ]] || fail "Podman is not rootless"
  printf '  rootless: true\n'

  printf 'Checking image and state volume...\n'
  podman image exists "$IMAGE" || fail "image '$IMAGE' is missing"
  podman volume exists "$STATE_VOLUME" || fail "state volume '$STATE_VOLUME' is missing"
  printf '  image: %s\n' "$IMAGE"
  printf '  state volume: %s\n' "$STATE_VOLUME"

  if command -v getenforce >/dev/null 2>&1; then
    enforcing="$(getenforce)"
    printf '  SELinux: %s\n' "$enforcing"
    if [[ "$enforcing" != "Enforcing" ]]; then
      printf 'Warning: SELinux is not enforcing; filesystem isolation still relies on Podman namespaces, but defense in depth is reduced.\n' >&2
    fi
  fi

  printf 'Checking Claude image...\n'
  show_version

  printf 'Checking authentication status...\n'
  if ! auth_status; then
    printf 'Warning: Claude is not authenticated yet. Run: claude-isolated login\n' >&2
  fi

  printf '\nStatic security properties used by run mode:\n'
  printf '  privileged: false (default)\n'
  printf '  capabilities: all dropped\n'
  printf '  no-new-privileges: enabled\n'
  printf '  workspace: canonical Git root at a unique stable path\n'
  printf '  bind mount: private SELinux relabel + non-recursive\n'
  printf '  persistent host data: Claude state volume only\n'
  printf '  host environment: only explicitly selected variables/secrets in run mode\n'
  printf '  SSH agent/container socket: not mounted or forwarded\n'

  if podman container exists "$RUN_CONTAINER_NAME" \
    && [[ "$(podman inspect --format '{{.State.Running}}' "$RUN_CONTAINER_NAME")" == "true" ]]; then
    printf '\nChecking running container %s...\n' "$RUN_CONTAINER_NAME"

    privileged="$(podman inspect --format '{{.HostConfig.Privileged}}' "$RUN_CONTAINER_NAME")"
    [[ "$privileged" == "false" ]] || fail "running container is privileged"

    caps="$(podman inspect --format '{{.EffectiveCaps}}/{{.BoundingCaps}}' "$RUN_CONTAINER_NAME")"
    [[ "$caps" == "[]/[]" ]] || fail "running container has effective or bounding capabilities: $caps"

    security_opts="$(podman inspect --format '{{.HostConfig.SecurityOpt}}' "$RUN_CONTAINER_NAME")"
    [[ "$security_opts" == *"no-new-privileges"* ]] \
      || fail "running container is missing no-new-privileges"

    require_command python3
    podman inspect "$RUN_CONTAINER_NAME" | python3 -I -c '
import json, os, re, sys
container = json.load(sys.stdin)[0]
mounts = container["Mounts"]
assert len(mounts) == 2, "expected exactly two mounts"
state = [m for m in mounts if m["Destination"] == "/state/claude"]
workspace = [m for m in mounts if re.fullmatch(r"/workspaces/[A-Za-z0-9_.-]+-[0-9a-f]{16}", m["Destination"])]
assert len(state) == len(workspace) == 1, "unexpected mount destinations"
assert state[0]["Type"] == "volume" and state[0]["Name"] == sys.argv[1], "unexpected state volume"
assert workspace[0]["Type"] == "bind", "workspace is not a bind mount"
assert container["Config"]["WorkingDir"] == workspace[0]["Destination"], "unexpected working directory"
source = workspace[0]["Source"]
home = os.path.realpath(os.path.expanduser("~"))
assert os.path.realpath(source) == source and source != "/" and not (home + "/").startswith(source + "/"), "unsafe workspace source"
import hashlib
# Launcher sanitization operates on UTF-8 bytes, matching LC_ALL=C tr.
name = re.sub(rb"[^a-zA-Z0-9_.-]", b"-", os.fsencode(os.path.basename(source)))[:48].decode("ascii")
expected = "/workspaces/" + name + "-" + hashlib.sha256(os.fsencode(source)).hexdigest()[:16]
assert workspace[0]["Destination"] == expected, "workspace identity does not match its source"
assert os.path.isdir(os.path.join(source, ".git")) and not os.path.islink(os.path.join(source, ".git")), "workspace has external Git metadata"
print("  workspace source: " + source)
print("  state volume: " + sys.argv[1])
' "$STATE_VOLUME"
    if command -v getenforce >/dev/null 2>&1 && [[ "$(getenforce)" == Enforcing ]]; then
      [[ -n "$(podman inspect --format '{{.ProcessLabel}}' "$RUN_CONTAINER_NAME")" ]] \
        || fail "running container has no SELinux process label"
    fi
    printf '  labels: '
    podman inspect --format 'process={{.ProcessLabel}} mount={{.MountLabel}}' "$RUN_CONTAINER_NAME"
  else
    printf '\nNo running %s container found; live-container checks skipped.\n' "$RUN_CONTAINER_NAME"
  fi
}

main() {
  parse_env_options "$@"
}

main_command() {
  case "${1:-}" in
    help|-h|--help)
      usage
      exit 0
      ;;
  esac

  case "${1:-}" in
    login|auth-status|logout|verify|version)
      [[ ${#RUN_ENV_ARGS[@]} -eq 0 ]] || fail "environment options apply only to run mode"
      ;;
  esac

  [[ "$STATE_VOLUME" != "${CODEX_ISOLATED_STATE_VOLUME:-codex-state}" ]] \
    || fail "Claude and Codex must use different state volumes"
  require_command podman
  require_command git
  require_command realpath
  check_rootless
  check_image_and_state
  require_command sha256sum

  case "${1:-}" in
    login)
      shift
      [[ $# -eq 0 ]] || fail "'login' takes no additional arguments"
      login_claude
      ;;
    auth-status)
      shift
      [[ $# -eq 0 ]] || fail "'auth-status' takes no additional arguments"
      auth_status
      ;;
    logout)
      shift
      [[ $# -eq 0 ]] || fail "'logout' takes no additional arguments"
      logout_claude
      ;;
    verify)
      shift
      [[ $# -eq 0 ]] || fail "'verify' takes no additional arguments"
      verify_setup
      ;;
    version)
      shift
      [[ $# -eq 0 ]] || fail "'version' takes no additional arguments"
      show_version
      ;;
    run)
      shift
      run_claude "$@"
      ;;
    --)
      shift
      run_claude "$@"
      ;;
    *)
      run_claude "$@"
      ;;
  esac
}

main "$@"
